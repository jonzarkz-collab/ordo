{
  "functions": {
    "api/scan.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/go/:code",
      "destination": "/api/go?c=:code"
    },
    {
      "source": "/go",
      "destination": "/api/go"
    }
  ]
}
